NEXT_PUBLIC_SUPABASE_URL=https://eizhomocgggmwsydhrow.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin login: one shared password (min 8 chars) and a random signing secret (min 32 chars).
# Without both, /admin stays locked. Changing ADMIN_PASSWORD signs every session out.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional super admin (min 8 chars, different from ADMIN_PASSWORD): can hide events from regular admins.
SUPER_ADMIN_PASSWORD=
# Optional photo gallery (Cloudflare R2, private bucket). Leave empty until the bucket exists:
# the gallery then says storage is not set up. See docs/setup.md, "Galeri foto acara".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
